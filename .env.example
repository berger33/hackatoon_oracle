# Oracle Cloud Infrastructure (OCI)
# Copie este arquivo para .env e preencha com os dados da sua tenancy.
# Nunca comite o arquivo .env com credenciais reais.

OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=./keys/oci_api_key.pem
OCI_REGION=sa-saopaulo-1

